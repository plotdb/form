extends /base.pug
block head
  style(type="text/css"): include:stylus index.styl
block body
  div.condition-editor-mount

  template.choice-cover
    .ldcv: .base: .inner.p-4.text-center
      h5.mb-3 請選擇表單類型
      .d-flex.justify-content-center.g-3
        button.btn.btn-outline-secondary(data-ldcv-set="simple") 一般範例
        button.btn.btn-primary(data-ldcv-set="award") 數位內容創新獎

  .w-1024.rwd.mx-auto.my-5.pb-5
    div(ld-each="widget")
    div(ld="form")

  .position-fixed.border-top.p-3.w-100.bg-white.shadow(style="bottom:0")
    .d-flex.g-2.align-items-center.w-1024.rwd.mx-auto
      .btn.btn-outline-secondary(ld="validate") Validate
      .btn.btn-outline-secondary(ld="dump") Dump
      .btn.btn-outline-secondary(ld="order") Order
      .btn.btn-outline-secondary(ld="edit-conditions") Conditions
      .flex-grow-1
        .mb-0.text-sm Progress
        .progress: .progress-bar.progress-bar-striped.progress-bar-animated(ld="progress-bar")

block script
  script(type="module")
    include:lsc api.ls
    include:lsc index.ls
